write_nic_tune_script() {
 echo
 echo ">> 写入网卡调优脚本和开机服务"
 cat > "$NIC_TUNE_SCRIPT" <<'EOF'
#!/usr/bin/env bash
set +e
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

exists() {
 command -v "$1" >/dev/null 2>&1
}

get_ifaces() {
 for p in /sys/class/net/*; do
  [ -e "$p" ]  continue
  i="${p##*/}"
  [ "$i" = "lo" ] && continue
  printf '%s\n' "$i"
 done
}

for i in $(get_ifaces); do
 echo "Tuning NIC: $i"
 ip link set dev "$i" txqueuelen 10000 2>/dev/null  true
 tc qdisc replace dev "$i" root fq 2>/dev/null  true
 if exists ethtool; then
  max_combined="$(ethtool -l "$i" 2>/dev/null | awk '/Combined:/ {v=$2} END{print v}')"
  if [ -n "${max_combined:-}" ] && [ "$max_combined" -gt 0 ] 2>/dev/null; then
   ethtool -L "$i" combined "$max_combined" 2>/dev/null  true
  fi
  rxmax="$(ethtool -g "$i" 2>/dev/null | awk '/Pre-set maximums:/ {m=1; next} m && /RX:/ {print $2; exit}')"
  txmax="$(ethtool -g "$i" 2>/dev/null | awk '/Pre-set maximums:/ {m=1; next} m && /TX:/ {print $2; exit}')"
  [ -n "${rxmax:-}" ] && ethtool -G "$i" rx "$rxmax" 2>/dev/null  true
  [ -n "${txmax:-}" ] && ethtool -G "$i" tx "$txmax" 2>/dev/null  true
  ethtool -K "$i" tso on gso on gro on rx on tx on 2>/dev/null  true
  ethtool -K "$i" lro on 2>/dev/null  true
  ethtool -C "$i" adaptive-rx on adaptive-tx on 2>/dev/null  true
  ethtool -C "$i" rx-usecs 50 tx-usecs 50 2>/dev/null  true
 fi
done

for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
 [ -w "$g" ] && echo performance > "$g" 2>/dev/null  true
done

[ -w /sys/kernel/mm/transparent_hugepage/enabled ] && echo madvise > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null  true
[ -w /sys/kernel/mm/transparent_hugepage/defrag ] && echo never > /sys/kernel/mm/transparent_hugepage/defrag 2>/dev/null  true

if command -v systemctl >/dev/null 2>&1; then
 systemctl enable --now irqbalance >/dev/null 2>&1  true
fi
EOF

 chmod +x "$NIC_TUNE_SCRIPT"
 cat > "$NIC_TUNE_SERVICE" <<EOF
[Unit]
Description=Aggressive NIC Tune
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=$NIC_TUNE_SCRIPT
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
EOF
 systemctl daemon-reload
 systemctl enable aggressive-nic-tune.service >/dev/null 2>&1  true
}

