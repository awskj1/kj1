 install -d -m 0755 /usr/local/sbin
 cat > /usr/local/sbin/aws-ip-report-client.py <<'EOF_IP_REPORT_CLIENT'
#!/usr/bin/env python3
import socket
import time
import requests

REPORT_URL = "http://107.182.173.168:18767/report"
TOKEN = 'jI4F1JIXmKnvzG0SPATHzRMym5vJfSLdpcMSOoNM7PM'
MACHINE_NUMBER = 1

PRIMARY_TARGETS = {
    "ipv4": ["gd-ct-v4.ip.zstaticcdn.com", "gd-cu-v4.ip.zstaticcdn.com", "gd-cm-v4.ip.zstaticcdn.com"],
    "ipv6": ["gd-ct-v6.ip.zstaticcdn.com", "gd-cm-v6.ip.zstaticcdn.com", "gd-cu-v6.ip.zstaticcdn.com"],
}
CONFIRM_TARGETS = {
    "ipv4": ["sh-ct-v4.ip.zstaticcdn.com", "sh-cm-v4.ip.zstaticcdn.com", "sh-cu-v4.ip.zstaticcdn.com"],
    "ipv6": ["sh-ct-v6.ip.zstaticcdn.com", "sh-cm-v6.ip.zstaticcdn.com", "sh-cu-v6.ip.zstaticcdn.com"],
}
TCP_PORT = 80
TCP_ATTEMPTS = 3
CONNECT_TIMEOUT = 1.5
INTERVAL = 10
REPORT_COOLDOWN = 120
last_report = {"ipv4": 0, "ipv6": 0}

def tcp_probe(domain, family):
    socket_family = socket.AF_INET6 if family == "ipv6" else socket.AF_INET
    attempts = []
    for attempt in range(1, TCP_ATTEMPTS + 1):
        try:
            addresses = socket.getaddrinfo(domain, TCP_PORT, socket_family, socket.SOCK_STREAM)
            address = addresses[0][4]
            with socket.socket(socket_family, socket.SOCK_STREAM) as sock:
                sock.settimeout(CONNECT_TIMEOUT)
                sock.connect(address)
            attempts.append({"attempt": attempt, "ok": True, "reason": "tcp_connected"})
            return True, {"domain": domain, "port": TCP_PORT, "attempts": attempts}
        except Exception as exc:
            attempts.append({"attempt": attempt, "ok": False, "reason": "%s:%s" % (type(exc).__name__, str(exc)[:100])})
    return False, {"domain": domain, "port": TCP_PORT, "attempts": attempts}

def tcp_stage(targets, family):
    results = []
    for domain in targets:
        healthy, detail = tcp_probe(domain, family)
        results.append(detail)
        if healthy:
            return True, results
    return False, results

def is_blocked(family):
    healthy, primary_detail = tcp_stage(PRIMARY_TARGETS[family], family)
    if healthy:
        return False, {"stage": "primary", "results": primary_detail}
    healthy, confirm_detail = tcp_stage(CONFIRM_TARGETS[family], family)
    detail = {"primary": primary_detail, "confirm": confirm_detail}
    return (False, detail) if healthy else (True, detail)

def report(family, detail):
    now = time.time()
    if now - last_report[family] < REPORT_COOLDOWN:
        return
    response = requests.post(
        REPORT_URL,
        headers={"Authorization": "Bearer " + TOKEN},
        json={"machine": MACHINE_NUMBER, "family": family, "blocked": True, "detail": detail},
        timeout=90,
    )
    print(time.strftime("%F %T"), family, "report", response.status_code, response.text[:500], flush=True)
    if response.status_code in (200, 202):
        last_report[family] = now

def main():
    while True:
        for family in ("ipv4", "ipv6"):
            try:
                blocked, detail = is_blocked(family)
                print(time.strftime("%F %T"), family, "tcping", "blocked" if blocked else "ok", flush=True)
                if blocked:
                    report(family, detail)
            except Exception as exc:
                print(time.strftime("%F %T"), family, "error", repr(exc), flush=True)
        time.sleep(INTERVAL)

if __name__ == "__main__":
    main()
EOF_IP_REPORT_CLIENT

 chmod 0755 /usr/local/sbin/aws-ip-report-client.py
 cat > /etc/systemd/system/aws-ip-report-client.service <<'EOF_IP_REPORT_SERVICE'
