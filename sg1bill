#!/usr/bin/env python3

import sys
import os
import datetime

from huaweicloudsdkcore.auth.credentials import BasicCredentials
from huaweicloudsdkcore.region.region import Region

from huaweicloudsdkdns.v2 import DnsClient

from huaweicloudsdkdns.v2.model import (
    ListRecordSetsByZoneRequest,
    UpdateRecordSetRequest,
    UpdateRecordSetReq,
)


DOMAIN = "aws.okns.lat."
ZONE_ID = "ff8080829fec9849019fefd711c34a4a"
REGION = "cn-north-4"

LOG_FILE = "/var/log/huawei-ddns.log"


def log(message):

    with open(LOG_FILE, "a") as f:

        f.write(
            datetime.datetime.now().strftime(
                "%Y-%m-%d %H:%M:%S"
            )
            + " "
            + message
            + "\n"
        )


# ============================================================
# 获取当前公网 IP
# ============================================================

if len(sys.argv) < 2:

    log("❌ update.py 没有收到公网 IP")

    sys.exit(1)


CURRENT_IP = sys.argv[1].strip()


if not CURRENT_IP:

    log("❌ 当前公网 IP 为空")

    sys.exit(1)


# ============================================================
# 读取 AK/SK
# ============================================================

AK = os.environ.get("HUAWEI_AK", "")
SK = os.environ.get("HUAWEI_SK", "")

ENV_FILE = "/etc/huawei-ddns.env"


if os.path.exists(ENV_FILE):

    try:

        with open(ENV_FILE, "r") as f:

            for line in f:

                line = line.strip()

                if not line:
                    continue

                if line.startswith("#"):
                    continue

                if line.startswith("HUAWEI_AK="):

                    AK = line.split(
                        "=",
                        1
                    )[1].strip().strip('"').strip("'")

                elif line.startswith("HUAWEI_SK="):

                    SK = line.split(
                        "=",
                        1
                    )[1].strip().strip('"').strip("'")

    except Exception as e:

        log(
            "❌ 读取 Huawei AK/SK 配置失败: "
            + str(e)
        )

        sys.exit(1)


if not AK or not SK:

    log(
        "❌ 没有找到 Huawei AK/SK"
    )

    sys.exit(1)


# ============================================================
# Huawei DNS Client
# ============================================================

try:

    credentials = BasicCredentials(
        AK,
        SK
    )

    client = DnsClient.new_builder() \
        .with_credentials(credentials) \
        .with_region(
            Region(
                REGION,
                "https://dns.cn-north-4.myhuaweicloud.com"
            )
        ) \
        .build()


    # ========================================================
    # 关键修复
    #
    # 这里必须查询整个 Zone。
    #
    # 不使用：
    #
    # name=aws.okns.lat
    #
    # 因为之前会拿到 SOA / NS，
    # 导致找不到真正 A Record。
    # ========================================================

    response = client.list_record_sets_by_zone(
        ListRecordSetsByZoneRequest(
            zone_id=ZONE_ID
        )
    )


    recordset = None


    # ========================================================
    # 精确寻找：
    #
    # aws.okns.lat.
    # A
    # ========================================================

    for item in response.recordsets or []:

        record_name = (
            item.name or ""
        ).rstrip(".").lower()

        record_type = (
            item.type or ""
        ).upper()


        if (
            record_name
            ==
            DOMAIN.rstrip(".").lower()
            and
            record_type
            ==
            "A"
        ):

            recordset = item

            log(
                "找到目标 A 记录: "
                + str(item.name)
                + " "
                + str(item.type)
                + " "
                + str(item.records)
                + " ID="
                + str(item.id)
            )

            break


        else:

            log(
                "跳过非目标记录: "
                + str(item.type)
                + " "
                + str(item.name)
            )


    # ========================================================
    # 没找到 A
    # ========================================================

    if recordset is None:

        log(
            "❌ 没找到 "
            + DOMAIN
            + " 的 A 记录"
        )

        sys.exit(2)


    # ========================================================
    # 获取 RecordSet ID
    # ========================================================

    recordset_id = recordset.id


    # ========================================================
    # 获取旧 IP
    # ========================================================

    old_ip = ""

    if recordset.records:

        old_ip = str(
            recordset.records[0]
        ).strip()


    # ========================================================
    # IP 没变化
    # ========================================================

    if old_ip == CURRENT_IP:

        log(
            "IP 未变化: "
            + CURRENT_IP
            + "，无需更新"
        )

        sys.exit(0)


    # ========================================================
    # IP 已变化
    # ========================================================

    log(
        "IP 变化: "
        + old_ip
        + " -> "
        + CURRENT_IP
    )


    # ========================================================
    # 直接 UPDATE
    #
    # 绝对不 CREATE
    # ========================================================

    body = UpdateRecordSetReq(

        name=recordset.name,

        type="A",

        records=[
            CURRENT_IP
        ],

        ttl=recordset.ttl
    )


    update_request = UpdateRecordSetRequest(

        zone_id=ZONE_ID,

        recordset_id=recordset_id,

        body=body
    )


    client.update_record_set(
        update_request
    )


    log(
        "✅ Huawei DNS 更新成功: "
        + DOMAIN
        + " A "
        + old_ip
        + " -> "
        + CURRENT_IP
    )


except Exception as e:

    log(
        "❌ Huawei DNS API 更新失败: "
        + str(e)
    )

    sys.exit(3)

PY


