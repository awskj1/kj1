#!/bin/bash

# =========================================================
# VPS 完整一键部署
#
# 1. BBR + DNS 自动调优
# 2. /opt/auto-tune 自动部署
# 3. auto-tune 开机自动执行
# 4. auto-tune 每天自动执行
# 5. Flux / GOST
# 6. Huawei Cloud DDNS
# 7. GTM Agent
# 8. 所有服务开机自启
# =========================================================

set +e

echo
echo "========================================================="
echo "           VPS 完整网络 / GOST / GTM / DDNS"
echo "========================================================="
echo


# =========================================================
# 变量
# =========================================================

DDNS_DOMAIN="aws.okns.lat"

HW_ACCESS_KEY_ID="HPUAUMSEKHJ9QE2KAQRF"
HW_SECRET_ACCESS_KEY="qR9eensb8KxX6yDQR92uVZELM0cAJCHQzcS7i9eT"
HW_DNS_REGION="cn-north-4"

FLUX_SERVER="flux-api.250809.xyz:6365"
FLUX_TOKEN="9a90013a24064ed0b5dff40a7ea7782a"

GTM_SERVER="https://dash.okns.lat"
GTM_TOKEN="78ac3f7695aca0ffeea2a066d5b161db"
GTM_IP="23.94.105.169"

AUTO_TUNE_URL="https://raw.githubusercontent.com/mfxyoffice-source/bbr-dns/main/bbr+dns"
AUTO_TUNE_DIR="/opt/auto-tune"


# =========================================================
# 1. 基础环境
# =========================================================

echo
echo "========== 1. 基础环境 =========="

apt update -y || true

apt install -y \
    curl \
    wget \
    jq \
    bsdutils \
    ca-certificates \
    openssh-server \
    python3 \
    python3-pip \
    python3-dev \
    dnsutils \
    git \
    || true


# =========================================================
# 2. BBR + DNS 调优
# =========================================================

echo
echo "========== 2. BBR + DNS 自动调优 =========="

mkdir -p "$AUTO_TUNE_DIR"

rm -f /tmp/bbr-dns.sh

echo "下载 BBR/DNS 调优脚本..."

if curl -fsSL \
    "$AUTO_TUNE_URL" \
    -o /tmp/bbr-dns.sh
then

    chmod +x /tmp/bbr-dns.sh

    echo "✅ BBR/DNS 脚本下载成功"

    echo
    echo "执行首次自动调优..."

    (
        sleep 3
        printf "\n"
    ) | bash /tmp/bbr-dns.sh || true

else

    echo "❌ BBR/DNS 脚本下载失败"

fi


# =========================================================
# 检查 auto-tune
# =========================================================

echo
echo "检查 /opt/auto-tune ..."

if [ -f "$AUTO_TUNE_DIR/auto-tune.py" ]
then

    echo "✅ 找到:"
    echo "$AUTO_TUNE_DIR/auto-tune.py"

else

    echo "⚠️ 未找到 auto-tune.py"

fi


# =========================================================
# 3. 创建 BBR/DNS 自动执行 Service
# =========================================================

echo
echo "========== 3. 配置 BBR/DNS 开机自动调优 =========="

cat > /etc/systemd/system/auto-tune.service << EOF
[Unit]
Description=Auto Tune BBR DNS and TCP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=${AUTO_TUNE_DIR}
ExecStart=/usr/bin/python3 ${AUTO_TUNE_DIR}/auto-tune.py auto
RemainAfterExit=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF


# =========================================================
# 4. 每日自动执行
# =========================================================

echo
echo "========== 4. 配置 BBR/DNS 定时自动调优 =========="

cat > /etc/systemd/system/auto-tune.timer << 'EOF'
[Unit]
Description=Auto Tune BBR DNS Daily

[Timer]
OnBootSec=3min
OnUnitActiveSec=24h
Persistent=true

[Install]
WantedBy=timers.target
EOF


# =========================================================
# 5. 启用 Auto Tune
# =========================================================

systemctl daemon-reload

systemctl enable auto-tune.service
systemctl enable auto-tune.timer

systemctl start auto-tune.timer

echo "✅ auto-tune.service 已设置开机执行"
echo "✅ auto-tune.timer 已设置每日执行"


# =========================================================
# 6. Flux / GOST
# =========================================================

echo
echo "========== 6. Flux / GOST =========="

rm -f ./install.sh 2>/dev/null || true

if curl -L \
    "http://${FLUX_SERVER}/agent/install.sh" \
    -o ./install.sh
then

    chmod +x ./install.sh

    echo "🚀 开始安装 GOST..."

    (
        sleep 3
        printf "\n"
    ) | ./install.sh \
        -a "$FLUX_SERVER" \
        -s "$FLUX_TOKEN"

    echo
    echo "✅ Flux/GOST 安装脚本执行完成"

else

    echo "❌ Flux/GOST 安装脚本下载失败"

fi

rm -f ./install.sh 2>/dev/null || true


# =========================================================
# 7. 清理旧 DDNS
# =========================================================

echo
echo "========== 7. 清理旧 DDNS =========="

systemctl stop huawei-ddns.service 2>/dev/null || true
systemctl disable huawei-ddns.service 2>/dev/null || true

rm -f /etc/cron.d/huawei-ddns

systemctl restart cron 2>/dev/null || \
systemctl restart crond 2>/dev/null || \
true


# =========================================================
# 8. Huawei DNS SDK
# =========================================================

echo
echo "========== 8. Huawei DNS SDK =========="

python3 -m pip install \
    -U \
    huaweicloudsdkcore \
    huaweicloudsdkdns \
    --break-system-packages \
    >/dev/null 2>&1 || true


if python3 -c \
    "import huaweicloudsdkcore, huaweicloudsdkdns" \
    >/dev/null 2>&1
then

    echo "✅ Huawei DNS SDK 安装成功"

else

    echo "⚠️ Huawei DNS SDK 安装失败，DDNS 会自动重试"

fi


# =========================================================
# 9. Huawei DDNS
# =========================================================

echo
echo "========== 9. 创建 Huawei DDNS =========="

cat > /root/huawei_ddns_loop.sh << 'DDNS_EOF'
#!/bin/bash

DDNS_DOMAIN="aws.okns.lat"

HW_ACCESS_KEY_ID="HPUAUMSEKHJ9QE2KAQRF"
HW_SECRET_ACCESS_KEY="qR9eensb8KxX6yDQR92uVZELM0cAJCHQzcS7i9eT"

HW_DNS_REGION="cn-north-4"

ZONE_NAME="aws.okns.lat."


echo "$(date '+%F %T') DDNS 启动"
echo "$(date '+%F %T') 域名: $DDNS_DOMAIN"
echo "$(date '+%F %T') Zone: $ZONE_NAME"


while true
do

    # =====================================================
    # Python
    # =====================================================

    if ! command -v python3 >/dev/null 2>&1
    then

        echo "$(date '+%F %T') Python3 不存在，安装中..."

        apt update -y >/dev/null 2>&1 || true

        apt install -y \
            python3 \
            python3-pip \
            python3-dev \
            >/dev/null 2>&1 || true

        sleep 3
        continue

    fi


    # =====================================================
    # pip
    # =====================================================

    if ! command -v pip3 >/dev/null 2>&1
    then

        echo "$(date '+%F %T') pip3 不存在，安装中..."

        apt install -y \
            python3-pip \
            >/dev/null 2>&1 || true

        sleep 3
        continue

    fi


    # =====================================================
    # Huawei SDK
    # =====================================================

    if ! python3 -c \
        "import huaweicloudsdkcore, huaweicloudsdkdns" \
        >/dev/null 2>&1
    then

        echo "$(date '+%F %T') Huawei DNS SDK 未安装，开始安装..."

        python3 -m pip install \
            -U \
            huaweicloudsdkcore \
            huaweicloudsdkdns \
            --break-system-packages \
            >/dev/null 2>&1 || true


        if ! python3 -c \
            "import huaweicloudsdkcore, huaweicloudsdkdns" \
            >/dev/null 2>&1
        then

            echo "$(date '+%F %T') SDK 安装失败，10秒后重试"

            sleep 10
            continue

        fi

        echo "$(date '+%F %T') Huawei DNS SDK 安装成功"

    fi


    # =====================================================
    # 获取公网 IPv4
    # =====================================================

    PUBLIC_IP=""

    PUBLIC_IP="$(
        curl -s -4 \
            --max-time 5 \
            https://api.ipify.org \
            2>/dev/null
    )"


    if ! echo "$PUBLIC_IP" | grep -Eq \
        '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    then

        PUBLIC_IP="$(
            curl -s -4 \
                --max-time 5 \
                https://ifconfig.me \
                2>/dev/null
        )"

    fi


    if ! echo "$PUBLIC_IP" | grep -Eq \
        '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    then

        PUBLIC_IP="$(
            curl -s -4 \
                --max-time 5 \
                https://icanhazip.com \
                2>/dev/null
        )"

    fi


    PUBLIC_IP="$(echo "$PUBLIC_IP" | tr -d '[:space:]')"


    if ! echo "$PUBLIC_IP" | grep -Eq \
        '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    then

        echo "$(date '+%F %T') ❌ 无法获取公网 IPv4"

        sleep 10
        continue

    fi


    echo "$(date '+%F %T') 当前公网 IP: $PUBLIC_IP"


    # =====================================================
    # Huawei DNS API
    # =====================================================

    python3 <<PYTHON

from huaweicloudsdkcore.auth.credentials import BasicCredentials

from huaweicloudsdkdns.v2.region.dns_region import DnsRegion

from huaweicloudsdkdns.v2 import (
    DnsClient,
    ListPublicZonesRequest,
    ListRecordSetsByZoneRequest,
    CreateRecordSetRequest,
    CreateRecordSetRequestBody,
    UpdateRecordSetRequest,
    UpdateRecordSetReq
)

from huaweicloudsdkcore.exceptions import exceptions

import time


AK = "$HW_ACCESS_KEY_ID"
SK = "$HW_SECRET_ACCESS_KEY"

DOMAIN = "$DDNS_DOMAIN."
ZONE_NAME = "$ZONE_NAME"
PUBLIC_IP = "$PUBLIC_IP"


try:

    credentials = BasicCredentials(
        AK,
        SK
    )


    client = (
        DnsClient
        .new_builder()
        .with_credentials(credentials)
        .with_region(
            DnsRegion.value_of("$HW_DNS_REGION")
        )
        .build()
    )


    # =====================================================
    # 查询 Zone
    # =====================================================

    zones_response = client.list_public_zones(
        ListPublicZonesRequest(
            name=ZONE_NAME
        )
    )


    zones = zones_response.zones or []


    if not zones:

        print(
            time.strftime("%F %T"),
            "❌ 未找到 Zone:",
            ZONE_NAME
        )

    else:

        zone_id = zones[0].id

        print(
            time.strftime("%F %T"),
            "Zone ID:",
            zone_id
        )


        # =================================================
        # 获取整个 Zone 的记录
        #
        # 不使用 name=DOMAIN
        #
        # 防止 Huawei API 返回 SOA 而找不到已有 A
        # =================================================

        rr_response = client.list_record_sets_by_zone(
            ListRecordSetsByZoneRequest(
                zone_id=zone_id
            )
        )


        rrsets = rr_response.recordsets or []


        print(
            time.strftime("%F %T"),
            "Zone 记录数量:",
            len(rrsets)
        )


        # =================================================
        # 精确匹配：
        #
        # aws.okns.lat.
        # type = A
        # =================================================

        a_records = []


        for rs in rrsets:

            record_type = getattr(
                rs,
                "type",
                ""
            )

            record_name = getattr(
                rs,
                "name",
                ""
            )


            if (
                record_type == "A"
                and record_name.rstrip(".").lower()
                == DOMAIN.rstrip(".").lower()
            ):

                a_records.append(rs)


        # =================================================
        # 已存在 A
        # =================================================

        if a_records:

            rs = a_records[0]

            rs_id = rs.id

            current_ip = None

            if rs.records:

                current_ip = rs.records[0]


            print(
                time.strftime("%F %T"),
                "找到 A:",
                DOMAIN,
                "->",
                current_ip
            )


            # =================================================
            # IP 没变化
            # =================================================

            if current_ip == PUBLIC_IP:

                print(
                    time.strftime("%F %T"),
                    "✅ IP 未变化，跳过:",
                    PUBLIC_IP
                )


            # =================================================
            # IP 变化
            # =================================================

            else:

                print(
                    time.strftime("%F %T"),
                    "IP 变化:",
                    current_ip,
                    "->",
                    PUBLIC_IP
                )


                update_req = UpdateRecordSetRequest(

                    zone_id=zone_id,

                    recordset_id=rs_id,

                    body=UpdateRecordSetReq(

                        name=DOMAIN,

                        type="A",

                        ttl=60,

                        records=[
                            PUBLIC_IP
                        ]

                    )
                )


                client.update_record_set(
                    update_req
                )


                print(
                    time.strftime("%F %T"),
                    "✅ A记录更新成功:",
                    DOMAIN,
                    "->",
                    PUBLIC_IP
                )


        # =================================================
        # 没有 A
        # =================================================

        else:

            print(
                time.strftime("%F %T"),
                "⚠️ 未找到 A，开始创建:",
                DOMAIN,
                "->",
                PUBLIC_IP
            )


            create_req = CreateRecordSetRequest(

                zone_id=zone_id,

                body=CreateRecordSetRequestBody(

                    name=DOMAIN,

                    type="A",

                    ttl=60,

                    records=[
                        PUBLIC_IP
                    ]

                )
            )


            client.create_record_set(
                create_req
            )


            print(
                time.strftime("%F %T"),
                "✅ A记录创建成功:",
                DOMAIN,
                "->",
                PUBLIC_IP
            )


except exceptions.ClientRequestException as e:

    print(
        time.strftime("%F %T"),
        "❌ Huawei DNS API:",
        "status=",
        e.status_code,
        "code=",
        e.error_code,
        "msg=",
        e.error_msg
    )


except Exception as e:

    print(
        time.strftime("%F %T"),
        "❌ DDNS 异常:",
        repr(e)
    )

PYTHON


    # =====================================================
    # 10 秒循环
    # =====================================================

    sleep 10

done

DDNS_EOF


chmod +x /root/huawei_ddns_loop.sh

bash -n /root/huawei_ddns_loop.sh

if [ $? -eq 0 ]
then
    echo "✅ DDNS 脚本语法正常"
else
    echo "❌ DDNS 脚本语法错误"
    exit 1
fi


# =========================================================
# 10. GTM Agent
# =========================================================

echo
echo "========== 10. GTM Agent =========="

curl -s \
    --resolve dash.okns.lat:443:23.94.105.169 \
    https://dash.okns.lat/agent.sh \
    -o /root/agent.sh


if [ -f /root/agent.sh ]
then

    chmod +x /root/agent.sh

    echo "✅ GTM Agent 下载完成"

else

    echo "❌ GTM Agent 下载失败"

fi


# =========================================================
# 11. GTM Service
# =========================================================

cat > /etc/systemd/system/gtm-agent.service << EOF
[Unit]
Description=GTM Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /root/agent.sh --server=${GTM_SERVER} --token=${GTM_TOKEN} --ip=${GTM_IP}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF


# =========================================================
# 12. Huawei DDNS Service
# =========================================================

echo
echo "========== 12. Huawei DDNS Service =========="

cat > /etc/systemd/system/huawei-ddns.service << 'EOF'
[Unit]
Description=Huawei DDNS 10s poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /root/huawei_ddns_loop.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

StandardOutput=append:/var/log/huawei-ddns.log
StandardError=append:/var/log/huawei-ddns.log

[Install]
WantedBy=multi-user.target
EOF


# =========================================================
# 13. Systemd
# =========================================================

echo
echo "========== 13. 启动所有服务 =========="

systemctl daemon-reload


# BBR/DNS
systemctl enable auto-tune.service
systemctl enable auto-tune.timer


# GTM
systemctl enable gtm-agent.service
systemctl restart gtm-agent.service


# DDNS
systemctl enable huawei-ddns.service
systemctl restart huawei-ddns.service


# =========================================================
# 14. 立即执行一次 auto-tune
# =========================================================

echo
echo "========== 14. 执行一次 BBR/DNS 自动调优 =========="

if [ -f "$AUTO_TUNE_DIR/auto-tune.py" ]
then

    systemctl start auto-tune.service

    echo "✅ auto-tune 已执行"

else

    echo "⚠️ /opt/auto-tune/auto-tune.py 不存在"
    echo "请检查远程 BBR/DNS 脚本"

fi


# =========================================================
# 15. 等待 DDNS
# =========================================================

echo
echo "等待 Huawei DDNS 首次同步..."

sleep 10


# =========================================================
# 16. 最终状态
# =========================================================

echo
echo
echo "========================================================="
echo "                    部署完成"
echo "========================================================="


echo
echo "========== GOST =========="

if systemctl is-active --quiet gost.service
then
    echo "✅ GOST: active"
else
    echo "❌ GOST: inactive"
fi


echo
echo "========== GTM =========="

if systemctl is-active --quiet gtm-agent.service
then
    echo "✅ GTM: active"
else
    echo "❌ GTM: inactive"
fi


echo
echo "========== Huawei DDNS =========="

if systemctl is-active --quiet huawei-ddns.service
then
    echo "✅ Huawei DDNS: active"
else
    echo "❌ Huawei DDNS: inactive"
fi


echo
echo "========== BBR/DNS Auto Tune =========="

if [ -f "$AUTO_TUNE_DIR/auto-tune.py" ]
then
    echo "✅ 调优目录: $AUTO_TUNE_DIR"
    echo "✅ 调优程序: $AUTO_TUNE_DIR/auto-tune.py"
else
    echo "❌ auto-tune.py 不存在"
fi


echo
echo "========== BBR 当前状态 =========="

sysctl net.ipv4.tcp_congestion_control 2>/dev/null || true

echo
echo "可用拥塞算法:"

sysctl net.ipv4.tcp_available_congestion_control 2>/dev/null || true


echo
echo "========== 公网 IPv4 =========="

curl -4 -s \
    --max-time 5 \
    https://api.ipify.org

echo


echo
echo "========== DNS A =========="

dig +short "$DDNS_DOMAIN" A


echo
echo "========== Auto Tune Timer =========="

systemctl list-timers \
    --all \
    --no-pager | grep auto-tune || true


echo
echo "========== DDNS 最近日志 =========="

tail -30 /var/log/huawei-ddns.log 2>/dev/null || true


echo
echo "========================================================="
echo "实时 DDNS:"
echo "journalctl -u huawei-ddns.service -f"
echo
echo "GTM:"
echo "journalctl -u gtm-agent.service -f"
echo
echo "BBR/DNS:"
echo "systemctl status auto-tune.service --no-pager"
echo
echo "BBR/DNS 定时:"
echo "systemctl status auto-tune.timer --no-pager"
echo
echo "调优目录:"
echo "ls -lah /opt/auto-tune/"
echo "========================================================="
