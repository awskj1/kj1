#!/bin/bash

LOG_FILE="/var/log/huawei-ddns.log"

get_public_ip() {

    local ip=""

    echo "[DDNS] 获取公网 IPv4..." >&2

    ip=$(curl -4 \
        -fsS \
        --connect-timeout 5 \
        --max-time 10 \
        https://api.ipify.org \
        2>/dev/null || true)


    if [[ -z "$ip" ]]; then

        echo "[DDNS] ipify 获取失败，尝试 ifconfig.me..." >&2

        ip=$(curl -4 \
            -fsS \
            --connect-timeout 5 \
            --max-time 10 \
            https://ifconfig.me/ip \
            2>/dev/null || true)

    fi


    if [[ -z "$ip" ]]; then

        echo "[DDNS] ifconfig.me 获取失败，尝试 icanhazip..." >&2

        ip=$(curl -4 \
            -fsS \
            --connect-timeout 5 \
            --max-time 10 \
            https://icanhazip.com \
            2>/dev/null || true)

    fi


    echo "$ip" | tr -d '[:space:]'
}


CURRENT_IP=$(get_public_ip)


