Restart=always
RestartSec=5

StandardOutput=append:/var/log/huawei-ddns.log
StandardError=append:/var/log/huawei-ddns.log

[Install]
WantedBy=multi-user.target
SERVICE_EOF


# =========================================================
# 启动 DDNS
# =========================================================

systemctl daemon-reload

systemctl enable huawei-ddns.service

systemctl restart huawei-ddns.service


# =========================================================
# 最终检查
# =========================================================

echo
echo "=========================================="
echo "部署完成"
echo "=========================================="

echo
echo "GTM:"
systemctl is-active gtm-agent.service

echo
echo "Huawei DDNS:"
systemctl is-active huawei-ddns.service

echo
echo "DDNS 域名:"
echo "aws.okns.lat"

echo
echo "实时日志:"
echo "journalctl -u huawei-ddns.service -f"

echo
echo "最近日志:"
journalctl -u huawei-ddns.service -n 20 --no-pager
