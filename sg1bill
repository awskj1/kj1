[Install]
WantedBy=multi-user.target
EOF


systemctl daemon-reload

systemctl enable --now gtm-agent.service


# =========================================================
# Huawei DDNS Systemd
# =========================================================

cat > /etc/systemd/system/huawei-ddns.service << 'SERVICE_EOF'
[Unit]
Description=Huawei DDNS 10s poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

