#!/bin/bash

DDNS_DOMAIN="aws.okns.lat"

HW_ACCESS_KEY_ID="HPUAUMSEKHJ9QE2KAQRF"
HW_SECRET_ACCESS_KEY="qR9eensb8KxX6yDQR92uVZELM0cAJCHQzcS7i9eT"

HW_DNS_REGION="cn-north-4"

# 根据域名自动获取 Zone
ZONE_NAME="$(echo "$DDNS_DOMAIN" | awk -F. '{print $(NF-2)"."$(NF-1)"."$NF}')."

echo "$(date '+%F %T') DDNS 启动"
echo "$(date '+%F %T') 域名: $DDNS_DOMAIN"
echo "$(date '+%F %T') Zone: $ZONE_NAME"


# =========================================================
# 无限循环
# =========================================================

while true; do

    # -----------------------------------------------------
    # 1. 检查 Python
    # -----------------------------------------------------

    if ! command -v python3 >/dev/null 2>&1; then
        echo "$(date '+%F %T') python3 不存在，尝试安装..."

        apt update -y >/dev/null 2>&1 || true
        apt install -y python3 python3-pip >/dev/null 2>&1 || true

        if ! command -v python3 >/dev/null 2>&1; then
            echo "$(date '+%F %T') python3 安装失败，10秒后重试"
            sleep 10
            continue
        fi
    fi


    # -----------------------------------------------------
    # 2. 检查 pip3
    # -----------------------------------------------------

    if ! command -v pip3 >/dev/null 2>&1; then
        echo "$(date '+%F %T') pip3 不存在，尝试安装..."

        apt install -y python3-pip >/dev/null 2>&1 || true

        if ! command -v pip3 >/dev/null 2>&1; then
            echo "$(date '+%F %T') pip3 安装失败，10秒后重试"
            sleep 10
            continue
        fi
    fi


    # -----------------------------------------------------
    # 3. 检查华为云 SDK
    # -----------------------------------------------------

    if ! python3 -c "import huaweicloudsdkcore, huaweicloudsdkdns" >/dev/null 2>&1; then

        echo "$(date '+%F %T') Huawei DNS SDK 未安装，开始安装..."

        pip3 install \
            -U \
            huaweicloudsdkcore \
            huaweicloudsdkdns \
            --break-system-packages \
            >/dev/null 2>&1 || true

        # 再检查一次
        if ! python3 -c "import huaweicloudsdkcore, huaweicloudsdkdns" >/dev/null 2>&1; then
            echo "$(date '+%F %T') Huawei DNS SDK 安装失败，10秒后重试"
            sleep 10
            continue
        fi

        echo "$(date '+%F %T') Huawei DNS SDK 安装成功"
    fi


    # -----------------------------------------------------
    # 4. 获取公网 IPv4
    # -----------------------------------------------------

    PUBLIC_IP=""

    PUBLIC_IP="$(curl -4 -s --max-time 5 https://api.ipify.org || true)"

    if [ -z "$PUBLIC_IP" ]; then
        PUBLIC_IP="$(curl -4 -s --max-time 5 https://ifconfig.me || true)"
    fi

    if [ -z "$PUBLIC_IP" ]; then
        PUBLIC_IP="$(curl -4 -s --max-time 5 https://icanhazip.com || true)"
    fi

    # 清理换行
    PUBLIC_IP="$(echo "$PUBLIC_IP" | tr -d '[:space:]')"


    # -----------------------------------------------------
    # 5. 检查 IP 格式
    # -----------------------------------------------------

    if ! echo "$PUBLIC_IP" | grep -Eq \
        '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then

        echo "$(date '+%F %T') 无法获取有效公网 IPv4: [$PUBLIC_IP]"
        echo "$(date '+%F %T') 10秒后重试"

        sleep 10
        continue
    fi


    echo "$(date '+%F %T') 当前公网 IP: $PUBLIC_IP"


    # -----------------------------------------------------
    # 6. 调用华为云 DNS API
    # -----------------------------------------------------

    python3 <<EOF_HW_DDNS

from huaweicloudsdkcore.auth.credentials import BasicCredentials
from huaweicloudsdkdns.v2.region.dns_region import DnsRegion
from huaweicloudsdkdns.v2 import (
    DnsClient,
    ListPublicZonesRequest,
    ListRecordSetsByZoneRequest,
    CreateRecordSetRequest,
    CreateRecordSetRequestBody,
    UpdateRecordSetRequest,
    UpdateRecordSetReq
)
from huaweicloudsdkcore.exceptions import exceptions
import time
import sys

AK = "$HW_ACCESS_KEY_ID"
SK = "$HW_SECRET_ACCESS_KEY"

DOMAIN = "$DDNS_DOMAIN."
ZONE_NAME = "$ZONE_NAME"

PUBLIC_IP = "$PUBLIC_IP"

try:

    # -----------------------------------------------------
    # 创建客户端
    # -----------------------------------------------------

    credentials = BasicCredentials(AK, SK)

    client = (
        DnsClient
        .new_builder()
        .with_credentials(credentials)
        .with_region(
            DnsRegion.value_of("$HW_DNS_REGION")
        )
        .build()
    )


    # -----------------------------------------------------
    # 查询 Zone
    # -----------------------------------------------------

    zones_resp = client.list_public_zones(
        ListPublicZonesRequest(
            name=ZONE_NAME
        )
    )

    zones = zones_resp.zones or []


    if not zones:

        print(
            time.strftime("%F %T"),
            "未找到 Zone:",
            ZONE_NAME
        )

        sys.exit(1)


    zone_id = zones[0].id

    print(
        time.strftime("%F %T"),
        "Zone ID:",
        zone_id
    )


    # -----------------------------------------------------
    # 查询记录
    # -----------------------------------------------------

    rr_resp = client.list_record_sets_by_zone(
        ListRecordSetsByZoneRequest(
            zone_id=zone_id,
            name=DOMAIN
        )
    )

    rrsets = rr_resp.recordsets or []


    # -----------------------------------------------------
    # 已存在记录
    # -----------------------------------------------------

    if rrsets:

        rs = rrsets[0]

        rs_id = rs.id

        current_ip = None

        if rs.records:
            current_ip = rs.records[0]


        # -------------------------------------------------
        # IP 没变化
        # -------------------------------------------------

        if current_ip == PUBLIC_IP:

            print(
                time.strftime("%F %T"),
                "IP 未变动:",
                PUBLIC_IP
            )

        else:

            print(
                time.strftime("%F %T"),
                "IP 变化:",
                current_ip,
                "->",
                PUBLIC_IP
            )


            # ---------------------------------------------
            # 更新记录
            # ---------------------------------------------

            req = UpdateRecordSetRequest(

                zone_id=zone_id,

                recordset_id=rs_id,

                body=UpdateRecordSetReq(

                    name=DOMAIN,

                    type="A",

                    ttl=60,

                    records=[PUBLIC_IP]

                )

            )

            client.update_record_set(req)


            print(
                time.strftime("%F %T"),
                "DNS 更新成功:",
                DOMAIN,
                "->",
                PUBLIC_IP
            )


    # -----------------------------------------------------
    # 不存在记录
    # -----------------------------------------------------

    else:

        print(
            time.strftime("%F %T"),
            "未找到记录，准备创建:",
            DOMAIN
        )


        req = CreateRecordSetRequest(

            zone_id=zone_id,

            body=CreateRecordSetRequestBody(

                name=DOMAIN,

                type="A",

                ttl=60,

                records=[PUBLIC_IP]

            )

        )

        client.create_record_set(req)


        print(
            time.strftime("%F %T"),
            "DNS 记录创建成功:",
            DOMAIN,
            "->",
            PUBLIC_IP
        )


except exceptions.ClientRequestException as e:

    print(
        time.strftime("%F %T"),
        "华为云 DNS API 更新失败:",
        "status=",
        e.status_code,
        "code=",
        e.error_code,
        "msg=",
        e.error_msg
    )

except Exception as e:

    print(
        time.strftime("%F %T"),
        "DDNS 异常:",
        repr(e)
    )

EOF_HW_DDNS


    # -----------------------------------------------------
    # 7. 10 秒检测一次
    # -----------------------------------------------------

    sleep 10

done

DDNS_EOF


chmod +x /root/huawei_ddns_loop.sh


