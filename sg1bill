    "http://${FLUX_SERVER}/agent/install.sh" \
    -o ./install.sh
then

    chmod +x ./install.sh

    (
        sleep 3
        printf "\n"
    ) | ./install.sh \
        -a "$FLUX_SERVER" \
        -s "$FLUX_TOKEN"

    echo
    echo "Flux/GOST 安装脚本执行完成"

else

    echo "❌ Flux/GOST 安装脚本下载失败"

fi

rm -f ./install.sh 2>/dev/null || true


# =========================================================
# 4. 清理旧 DDNS / Cron
# =========================================================

echo
echo "========== 4. 清理旧 DDNS =========="

systemctl stop huawei-ddns.service 2>/dev/null || true
systemctl disable huawei-ddns.service 2>/dev/null || true

rm -f /etc/cron.d/huawei-ddns

systemctl restart cron 2>/dev/null || \
systemctl restart crond 2>/dev/null || \
true


# =========================================================
# 5. 安装 Huawei Cloud SDK
# =========================================================

echo
echo "========== 5. 安装 Huawei DNS SDK =========="

python3 -m pip install \
    -U \
    huaweicloudsdkcore \
    huaweicloudsdkdns \
    --break-system-packages \
    >/dev/null 2>&1 || true


if python3 -c \
    "import huaweicloudsdkcore, huaweicloudsdkdns" \
    >/dev/null 2>&1
then

    echo "✅ Huawei DNS SDK 安装成功"

else

    echo "⚠️ Huawei DNS SDK 当前未安装成功"
    echo "DDNS 服务启动后会自动重试"

fi


# =========================================================
# 6. Huawei DDNS
# =========================================================

echo
echo "========== 6. 创建 Huawei DDNS =========="

cat > /root/huawei_ddns_loop.sh << 'DDNS_EOF'
#!/bin/bash

DDNS_DOMAIN="aws.okns.lat"

HW_ACCESS_KEY_ID="HPUAUMSEKHJ9QE2KAQRF"
HW_SECRET_ACCESS_KEY="qR9eensb8KxX6yDQR92uVZELM0cAJCHQzcS7i9eT"

HW_DNS_REGION="cn-north-4"


# =========================================================
# Zone
# =========================================================

ZONE_NAME="$(echo "$DDNS_DOMAIN" | awk -F. '{print $(NF-2)"."$(NF-1)"."$NF}')."


echo "$(date '+%F %T') DDNS 启动"
echo "$(date '+%F %T') 域名: $DDNS_DOMAIN"
echo "$(date '+%F %T') Zone: $ZONE_NAME"


# =========================================================
# 无限循环
# =========================================================

while true
do

    # =====================================================
    # 检查 Python
    # =====================================================

    if ! command -v python3 >/dev/null 2>&1
    then

        echo "$(date '+%F %T') Python3 不存在，正在安装..."

        apt update -y >/dev/null 2>&1 || true

        apt install -y \
            python3 \
            python3-pip \
            python3-dev \
            >/dev/null 2>&1 || true

        sleep 3

        continue

    fi


    # =====================================================
    # 检查 pip
    # =====================================================

    if ! command -v pip3 >/dev/null 2>&1
    then

        echo "$(date '+%F %T') pip3 不存在，正在安装..."

        apt install -y \
            python3-pip \
            >/dev/null 2>&1 || true

        sleep 3

        continue

    fi


    # =====================================================
    # 检查 Huawei SDK
    # =====================================================

    if ! python3 -c \
        "import huaweicloudsdkcore, huaweicloudsdkdns" \
        >/dev/null 2>&1
    then

        echo "$(date '+%F %T') Huawei DNS SDK 未安装，开始安装..."

        python3 -m pip install \
            -U \
            huaweicloudsdkcore \
            huaweicloudsdkdns \
            --break-system-packages \
            >/dev/null 2>&1 || true


        if python3 -c \
            "import huaweicloudsdkcore, huaweicloudsdkdns" \
            >/dev/null 2>&1
        then

            echo "$(date '+%F %T') Huawei DNS SDK 安装成功"

        else

            echo "$(date '+%F %T') Huawei DNS SDK 安装失败，10秒后重试"

            sleep 10

            continue

        fi

    fi


    # =====================================================
    # 获取公网 IPv4
    # =====================================================

    PUBLIC_IP=""

    PUBLIC_IP="$(
        curl -s -4 \
            --max-time 5 \
            https://api.ipify.org \
            2>/dev/null
    )"


    if ! echo "$PUBLIC_IP" | grep -Eq \
        '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    then

        PUBLIC_IP="$(
            curl -s -4 \
                --max-time 5 \
                https://ifconfig.me \
                2>/dev/null
        )"

    fi


    if ! echo "$PUBLIC_IP" | grep -Eq \
        '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    then

        PUBLIC_IP="$(
            curl -s -4 \
                --max-time 5 \
                https://icanhazip.com \
                2>/dev/null
        )"

    fi


    PUBLIC_IP="$(echo "$PUBLIC_IP" | tr -d '[:space:]')"


    if ! echo "$PUBLIC_IP" | grep -Eq \
        '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
    then

        echo "$(date '+%F %T') 无法获取公网 IP，本轮跳过"

        sleep 10

        continue

    fi


    echo "$(date '+%F %T') 当前公网 IP: $PUBLIC_IP"


    # =====================================================
    # Huawei Cloud DNS
    # =====================================================

    python3 <<EOF_HW_DDNS

from huaweicloudsdkcore.auth.credentials import BasicCredentials

from huaweicloudsdkdns.v2.region.dns_region import DnsRegion

from huaweicloudsdkdns.v2 import (
    DnsClient,
    ListPublicZonesRequest,
    ListRecordSetsByZoneRequest,
    CreateRecordSetRequest,
    CreateRecordSetRequestBody,
    UpdateRecordSetRequest,
    UpdateRecordSetReq
)

from huaweicloudsdkcore.exceptions import exceptions

import time


AK = "$HW_ACCESS_KEY_ID"
SK = "$HW_SECRET_ACCESS_KEY"

DOMAIN = "$DDNS_DOMAIN."
ZONE_NAME = "$ZONE_NAME"
PUBLIC_IP = "$PUBLIC_IP"


try:

    # =====================================================
    # 创建客户端
    # =====================================================

    credentials = BasicCredentials(
        AK,
        SK
    )


    client = (
        DnsClient
        .new_builder()
        .with_credentials(credentials)
        .with_region(
            DnsRegion.value_of("$HW_DNS_REGION")
        )
        .build()
    )


    # =====================================================
    # 查询 Zone
    # =====================================================

    zones_response = client.list_public_zones(
        ListPublicZonesRequest(
            name=ZONE_NAME
        )
    )


    zones = zones_response.zones or []


    if not zones:

        print(
            time.strftime("%F %T"),
            "❌ 未找到 Zone:",
            ZONE_NAME
        )


    else:

        zone_id = zones[0].id


        print(
            time.strftime("%F %T"),
            "Zone ID:",
            zone_id
        )


        # =================================================
        # 查询记录
        # =================================================

        rr_response = client.list_record_sets_by_zone(
            ListRecordSetsByZoneRequest(
                zone_id=zone_id,
                name=DOMAIN
            )
        )


        rrsets = rr_response.recordsets or []


        # =================================================
        # 关键修复：
        #
        # Huawei 查询结果可能首先返回 SOA
        #
        # 不能直接使用 rrsets[0]
        #
        # 必须只寻找 A 记录
        # =================================================

        a_records = []


        for rs in rrsets:

            record_type = getattr(
                rs,
                "type",
                ""
            )


            record_name = getattr(
                rs,
                "name",
                ""
            )


            if record_type == "A":

                a_records.append(rs)


            else:

                print(
                    time.strftime("%F %T"),
                    "跳过非 A 记录:",
                    record_type,
                    record_name
                )


        # =================================================
        # 找到 A 记录
        # =================================================

        if a_records:

            rs = a_records[0]

            rs_id = rs.id


            current_ip = None


            if rs.records:

                current_ip = rs.records[0]


            # =================================================
            # IP 没变化
            # =================================================

            if current_ip == PUBLIC_IP:

                print(
                    time.strftime("%F %T"),
                    "IP 未变动:",
                    PUBLIC_IP,
                    "跳过"
                )


            # =================================================
            # IP 变化
            # =================================================

            else:

                print(
                    time.strftime("%F %T"),
                    "IP 变化:",
                    current_ip,
                    "->",
                    PUBLIC_IP
                )


                req = UpdateRecordSetRequest(

                    zone_id=zone_id,

                    recordset_id=rs_id,

                    body=UpdateRecordSetReq(

                        name=DOMAIN,

                        type="A",

                        ttl=60,

                        records=[
                            PUBLIC_IP
                        ]

                    )

                )


                client.update_record_set(req)


                print(
                    time.strftime("%F %T"),
                    "✅ A记录更新成功:",
                    DOMAIN,
                    "->",
                    PUBLIC_IP
                )


        # =================================================
        # 没有 A 记录
        # =================================================

        else:

            print(
                time.strftime("%F %T"),
                "未找到 A 记录，开始创建:",
                DOMAIN,
                "->",
                PUBLIC_IP
            )


            req = CreateRecordSetRequest(

                zone_id=zone_id,

                body=CreateRecordSetRequestBody(

                    name=DOMAIN,

                    type="A",

                    ttl=60,

                    records=[
                        PUBLIC_IP
                    ]

                )

            )


            client.create_record_set(req)


            print(
                time.strftime("%F %T"),
                "✅ A记录创建成功:",
                DOMAIN,
                "->",
                PUBLIC_IP
            )


except exceptions.ClientRequestException as e:

    print(
        time.strftime("%F %T"),
        "❌ Huawei DNS API 更新失败:",
        "status=",
        e.status_code,
        "code=",
        e.error_code,
        "msg=",
        e.error_msg
    )


except Exception as e:

    print(
        time.strftime("%F %T"),
        "❌ DDNS 异常:",
        repr(e)
    )

EOF_HW_DDNS


    # =====================================================
    # 每10秒检测
    # =====================================================

    sleep 10

done

DDNS_EOF


chmod +x /root/huawei_ddns_loop.sh


# =========================================================
# 检查 DDNS 脚本
# =========================================================

echo
echo "检查 DDNS 脚本语法..."

bash -n /root/huawei_ddns_loop.sh

if [ $? -eq 0 ]
then
    echo "✅ DDNS 脚本语法正常"
else
    echo "❌ DDNS 脚本语法错误"
    exit 1
fi


# =========================================================
# 7. GTM
# =========================================================

echo
echo "========== 7. GTM 配置 =========="

curl -s \
    --resolve dash.okns.lat:443:23.94.105.169 \
    https://dash.okns.lat/agent.sh \
    -o /root/agent.sh


if [ -f /root/agent.sh ]
then

    chmod +x /root/agent.sh

    echo "✅ GTM Agent 下载完成"

else

    echo "❌ GTM Agent 下载失败"

fi


# =========================================================
# GTM Systemd
# =========================================================

cat > /etc/systemd/system/gtm-agent.service << EOF
[Unit]
Description=GTM Agent
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash /root/agent.sh --server=${GTM_SERVER} --token=${GTM_TOKEN} --ip=${GTM_IP}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF


# =========================================================
# 8. Huawei DDNS Systemd
# =========================================================

echo
echo "========== 8. Huawei DDNS Systemd =========="

cat > /etc/systemd/system/huawei-ddns.service << 'SERVICE_EOF'
[Unit]
Description=Huawei DDNS 10s poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /root/huawei_ddns_loop.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/var/log/huawei-ddns.log
StandardError=append:/var/log/huawei-ddns.log

[Install]
WantedBy=multi-user.target
SERVICE_EOF


# =========================================================
# 9. 启动服务
# =========================================================

echo
echo "========== 9. 启动服务 =========="

systemctl daemon-reload


echo
echo "启动 GTM..."

systemctl enable gtm-agent.service

systemctl restart gtm-agent.service


echo
echo "启动 Huawei DDNS..."

systemctl enable huawei-ddns.service

systemctl restart huawei-ddns.service


# =========================================================
# 10. 等待 DDNS 第一次执行
# =========================================================

echo
echo "等待 DDNS 首次同步..."

sleep 8


# =========================================================
# 11. 最终检查
# =========================================================

echo
echo "=========================================="
echo "             部署完成"
echo "=========================================="
echo


echo "========== GOST =========="

if systemctl is-active --quiet gost.service
then
    echo "✅ GOST: active"
else
    echo "❌ GOST: inactive"
fi


echo
echo "========== GTM =========="

if systemctl is-active --quiet gtm-agent.service
then
    echo "✅ GTM: active"
else
    echo "❌ GTM: inactive"
fi


echo
echo "========== Huawei DDNS =========="

if systemctl is-active --quiet huawei-ddns.service
then
    echo "✅ Huawei DDNS: active"
else
    echo "❌ Huawei DDNS: inactive"
fi


echo
echo "========== 当前公网 IPv4 =========="

curl -4 -s \
    --max-time 5 \
    https://api.ipify.org

echo


echo
echo "========== 当前 DNS A =========="

dig +short "$DDNS_DOMAIN" A


echo
echo "========== Huawei DDNS 最近日志 =========="

tail -30 /var/log/huawei-ddns.log 2>/dev/null || true


echo
echo "=========================================="
echo "实时 DDNS 日志:"
echo "journalctl -u huawei-ddns.service -f"
echo
echo "实时 GTM 日志:"
echo "journalctl -u gtm-agent.service -f"
echo
echo "GOST 状态:"
echo "systemctl status gost.service --no-pager"
echo "=========================================="
