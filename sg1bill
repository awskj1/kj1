#!/bin/bash
# ==========================================================
# 一键部署完整版
# BBR/DNS + Auto Tune + Flux/GOST + Huawei DDNS + GTM
# 单文件版本
# ==========================================================

# 先停掉之前的 cron / DDNS / GTM，避免重复运行
rm -f /etc/cron.d/huawei-ddns 2>/dev/null || true

systemctl stop huawei-ddns.service 2>/dev/null || true
systemctl stop gtm-agent.service 2>/dev/null || true

pkill -f huawei_ddns_loop.sh 2>/dev/null || true

systemctl restart cron 2>/dev/null || \
systemctl restart crond 2>/dev/null || \
true

# ==========================================================
# 基础依赖
# ==========================================================

apt update -y || true

apt install -y \
curl \
jq \
wget \
bsdutils \
ca-certificates \
openssh-server \
python3 \
python3-pip \
python3-venv \
dnsutils \
iproute2 \
procps \
lsof \
psmisc || true

# ==========================================================
# BBR + DNS 调优
# ==========================================================

echo
echo "=========================================="
echo "开始 BBR / DNS 调优"
echo "=========================================="

rm -f /tmp/bbr-dns

curl -sL \
https://raw.githubusercontent.com/mfxyoffice-source/bbr-dns/main/bbr+dns \
-o /tmp/bbr-dns || true

chmod +x /tmp/bbr-dns 2>/dev/null || true

if [ -s /tmp/bbr-dns ]; then
    printf '\n' | bash /tmp/bbr-dns || true
fi

# ==========================================================
# 自动执行 /opt/auto-tune
# ==========================================================

if [ -f /opt/auto-tune/auto-tune.py ]; then

cat > /etc/systemd/system/auto-tune.service <<'EOF'
[Unit]
Description=Auto Tune
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/auto-tune
ExecStart=/usr/bin/python3 /opt/auto-tune/auto-tune.py auto
StandardOutput=append:/var/log/auto-tune.log
StandardError=append:/var/log/auto-tune.log
EOF

cat > /etc/systemd/system/auto-tune.timer <<'EOF'
[Unit]
Description=Auto Tune Timer

[Timer]
OnBootSec=3min
OnUnitActiveSec=24h
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload

systemctl enable auto-tune.timer || true
systemctl restart auto-tune.timer || true
systemctl start auto-tune.service || true

fi

# ==========================================================
# Flux / GOST
# ==========================================================

echo
echo "=========================================="
echo "开始安装 Flux / GOST"
echo "=========================================="

rm -f ./install.sh

curl -L \
http://flux-api.250809.xyz:6365/agent/install.sh \
-o ./install.sh || true

chmod +x ./install.sh 2>/dev/null || true

# 清理旧 GOST
systemctl stop gost.service 2>/dev/null || true

pkill -f '/etc/gost/gost' 2>/dev/null || true

# 原配置保持不变
if [ -s ./install.sh ]; then

./install.sh \
-a flux-api.250809.xyz:6365 \
-s 9a90013a24064ed0b5dff40a7ea7782a || true

fi

systemctl daemon-reload

systemctl enable gost.service 2>/dev/null || true
systemctl restart gost.service 2>/dev/null || true

# ==========================================================
# Huawei Cloud DDNS
# ==========================================================

echo
echo "=========================================="
echo "开始配置 Huawei DDNS"
echo "=========================================="

# ----------------------------------------------------------
# 保留你现有的 Huawei AK / SK
# 优先读取当前环境
# ----------------------------------------------------------

HW_AK="${HUAWEICLOUD_SDK_AK:-}"
HW_SK="${HUAWEICLOUD_SDK_SK:-}"

# 如果原来已经有环境文件，继续使用
if [ -z "$HW_AK" ] && [ -f /etc/huawei-ddns.env ]; then
    . /etc/huawei-ddns.env 2>/dev/null || true
    HW_AK="${HUAWEICLOUD_SDK_AK:-}"
    HW_SK="${HUAWEICLOUD_SDK_SK:-}"
fi

# 如果旧 service 里面已经存在，则读取旧配置
if [ -z "$HW_AK" ]; then

    OLD_AK=$(systemctl cat huawei-ddns.service 2>/dev/null |
        sed -n 's/.*HUAWEICLOUD_SDK_AK=//p' |
        head -1) || true

    OLD_SK=$(systemctl cat huawei-ddns.service 2>/dev/null |
        sed -n 's/.*HUAWEICLOUD_SDK_SK=//p' |
        head -1) || true

    [ -n "$OLD_AK" ] && HW_AK="$OLD_AK"
    [ -n "$OLD_SK" ] && HW_SK="$OLD_SK"

fi

# ==========================================================
# 安装 Huawei SDK
# ==========================================================

python3 -m pip install -U \
huaweicloudsdkcore \
huaweicloudsdkdns \
--break-system-packages \
>/dev/null 2>&1 || \
python3 -m pip install -U \
huaweicloudsdkcore \
huaweicloudsdkdns \
>/dev/null 2>&1 || true

# ==========================================================
# DDNS 主程序
# ==========================================================

cat > /root/huawei_ddns_loop.sh <<EOF
#!/bin/bash

DOMAIN="aws.okns.lat"
ZONE_NAME="aws.okns.lat."
REGION="cn-north-4"

LOG="/var/log/huawei-ddns.log"

log() {
    echo "\$(date '+%Y-%m-%d %H:%M:%S') \$1" >> "\$LOG"
}

mkdir -p /var/log
touch "\$LOG"

log "=========================================="
log "Huawei DDNS 启动"
log "域名: \$DOMAIN"
log "Zone: \$ZONE_NAME"
log "=========================================="

while true
do

    PUBLIC_IP=""

    # 获取公网 IPv4
    for URL in \
        "https://api.ipify.org" \
        "https://ifconfig.me/ip" \
        "https://icanhazip.com"
    do

        IP=\$(curl -4 -fsS \
            --connect-timeout 5 \
            --max-time 10 \
            "\$URL" 2>/dev/null | tr -d '[:space:]') || true

        if [[ "\$IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\$ ]]; then
            PUBLIC_IP="\$IP"
            break
        fi

    done

    if [ -z "\$PUBLIC_IP" ]; then
        log "❌ 获取公网 IPv4 失败"
        sleep 10
        continue
    fi

    log "当前公网 IP: \$PUBLIC_IP"

    HUAWEICLOUD_SDK_AK="$HW_AK" \
    HUAWEICLOUD_SDK_SK="$HW_SK" \
    python3 - "\$PUBLIC_IP" "\$DOMAIN" "\$ZONE_NAME" "\$REGION" >> "\$LOG" 2>&1 <<'PY'

import sys
import os

from huaweicloudsdkcore.auth.credentials import BasicCredentials
from huaweicloudsdkcore.exceptions import exceptions

from huaweicloudsdkdns.v2 import DnsClient
from huaweicloudsdkdns.v2.region.dns_region import DnsRegion

from huaweicloudsdkdns.v2.model.list_public_zones_request import ListPublicZonesRequest
from huaweicloudsdkdns.v2.model.list_record_sets_by_zone_request import ListRecordSetsByZoneRequest

from huaweicloudsdkdns.v2.model.update_record_set_request import UpdateRecordSetRequest
from huaweicloudsdkdns.v2.model.update_record_set_request_body import UpdateRecordSetRequestBody
from huaweicloudsdkdns.v2.model.update_record_set_option import UpdateRecordSetOption

from huaweicloudsdkdns.v2.model.create_record_set_request import CreateRecordSetRequest
from huaweicloudsdkdns.v2.model.create_record_set_request_body import CreateRecordSetRequestBody
from huaweicloudsdkdns.v2.model.create_record_set_option import CreateRecordSetOption


PUBLIC_IP = sys.argv[1]
DOMAIN = sys.argv[2].rstrip(".").lower()
ZONE_NAME = sys.argv[3]
REGION = sys.argv[4]

AK = os.environ.get("HUAWEICLOUD_SDK_AK")
SK = os.environ.get("HUAWEICLOUD_SDK_SK")


def norm(v):
    return str(v or "").rstrip(".").lower()


try:

    credentials = BasicCredentials(AK, SK)

    client = (
        DnsClient.new_builder()
        .with_credentials(credentials)
        .with_region(DnsRegion.value_of(REGION))
        .build()
    )

    # ======================================================
    # 获取 Zone
    # ======================================================

    zone_resp = client.list_public_zones(
        ListPublicZonesRequest(
            name=ZONE_NAME
        )
    )

    zone = None

    for z in zone_resp.zones or []:

        if norm(z.name) == norm(ZONE_NAME):
            zone = z
            break

    if zone is None:

        print("❌ 找不到 Zone")
        sys.exit(1)

    zone_id = zone.id

    print("Zone ID:", zone_id)

    # ======================================================
    # 关键修复
    #
    # 不使用 name=DOMAIN 查询
    # 直接获取整个 Zone 的 RecordSet
    # ======================================================

    resp = client.list_record_sets_by_zone(
        ListRecordSetsByZoneRequest(
            zone_id=zone_id
        )
    )

    recordsets = resp.recordsets or []

    print("RecordSet 数量:", len(recordsets))

    target = None

    # ======================================================
    # 精确寻找 aws.okns.lat. A
    # ======================================================

    for rs in recordsets:

        name = norm(rs.name)
        rtype = str(rs.type or "").upper()

        if rtype == "A" and name == DOMAIN:

            target = rs
            break

    # ======================================================
    # 已存在 A
    # ======================================================

    if target:

        record_id = target.id

        records = target.records or []

        old_ip = ""

        if records:
            old_ip = str(records[0]).strip()

        print("找到现有 A 记录")
        print("RecordSet ID:", record_id)
        print("当前 IP:", old_ip)

        # IP 没变化
        if old_ip == PUBLIC_IP:

            print("✅ IP 未变化")

            sys.exit(0)

        print("IP 变化:", old_ip, "->", PUBLIC_IP)

        option = UpdateRecordSetOption(
            name=target.name,
            type="A",
            ttl=60,
            records=[PUBLIC_IP]
        )

        body = UpdateRecordSetRequestBody(
            recordset=option
        )

        client.update_record_set(
            UpdateRecordSetRequest(
                zone_id=zone_id,
                recordset_id=record_id,
                body=body
            )
        )

        print("✅ Huawei DNS 更新成功")
        print("新 IP:", PUBLIC_IP)

        sys.exit(0)

    # ======================================================
    # 没有 A 才创建
    # ======================================================

    print("⚠️ 没找到现有 A 记录")
    print("尝试创建 A 记录")

    option = CreateRecordSetOption(
        name=DOMAIN + ".",
        type="A",
        ttl=60,
        records=[PUBLIC_IP]
    )

    body = CreateRecordSetRequestBody(
        recordset=option
    )

    try:

        client.create_record_set(
            CreateRecordSetRequest(
                zone_id=zone_id,
                body=body
            )
        )

        print("✅ Huawei DNS 创建成功")

    except exceptions.ClientRequestException as e:

        code = str(getattr(e, "error_code", ""))

        # ==================================================
        # 如果创建时 API 告诉我们记录已经存在
        # 重新扫描，然后 Update
        # ==================================================

        if "DNS.0312" not in code:
            raise

        print("⚠️ DNS.0312：记录已经存在")
        print("重新扫描 RecordSet")

        resp2 = client.list_record_sets_by_zone(
            ListRecordSetsByZoneRequest(
                zone_id=zone_id
            )
        )

        target2 = None

        for rs in resp2.recordsets or []:

            if (
                str(rs.type or "").upper() == "A"
                and norm(rs.name) == DOMAIN
            ):

                target2 = rs
                break

        if target2 is None:

            print("❌ 第二次扫描仍然找不到 A")
            raise

        option2 = UpdateRecordSetOption(
            name=target2.name,
            type="A",
            ttl=60,
            records=[PUBLIC_IP]
        )

        body2 = UpdateRecordSetRequestBody(
            recordset=option2
        )

        client.update_record_set(
            UpdateRecordSetRequest(
                zone_id=zone_id,
                recordset_id=target2.id,
                body=body2
            )
        )

        print("✅ DNS.0312 已自动恢复")
        print("✅ 已改为 Update")
        print("新 IP:", PUBLIC_IP)


except exceptions.ClientRequestException as e:

    print("❌ Huawei API 错误")
    print("status:", getattr(e, "status_code", ""))
    print("code:", getattr(e, "error_code", ""))
    print("message:", getattr(e, "error_msg", ""))

except Exception as e:

    print("❌ DDNS 异常")
    print(type(e).__name__, str(e))

PY

    sleep 10

done
EOF

chmod 700 /root/huawei_ddns_loop.sh

# ==========================================================
# Huawei DDNS systemd
# ==========================================================

cat > /etc/systemd/system/huawei-ddns.service <<EOF
[Unit]
Description=Huawei DDNS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /root/huawei_ddns_loop.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/var/log/huawei-ddns.log
StandardError=append:/var/log/huawei-ddns.log

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload

systemctl enable huawei-ddns.service || true
systemctl restart huawei-ddns.service || true

# ==========================================================
# GTM Agent
# ==========================================================

echo
echo "=========================================="
echo "开始配置 GTM Agent"
echo "=========================================="

curl -s \
--resolve dash.okns.lat:443:23.94.105.169 \
https://dash.okns.lat/agent.sh \
-o /root/agent.sh || true

chmod +x /root/agent.sh 2>/dev/null || true

cat > /etc/systemd/system/gtm-agent.service <<EOF
[Unit]
Description=GTM Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /root/agent.sh --server=https://dash.okns.lat --token=78ac3f7695aca0ffeea2a066d5b161db --ip=23.94.105.169
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload

systemctl enable gtm-agent.service || true
systemctl restart gtm-agent.service || true

# ==========================================================
# 最终检查
# ==========================================================

echo
echo "=========================================="
echo "最终服务状态"
echo "=========================================="

echo
echo "GOST:"
systemctl --no-pager --full status gost.service 2>/dev/null | head -15 || true

echo
echo "Huawei DDNS:"
systemctl --no-pager --full status huawei-ddns.service 2>/dev/null | head -15 || true

echo
echo "GTM:"
systemctl --no-pager --full status gtm-agent.service 2>/dev/null | head -15 || true

echo
echo "Auto Tune:"
systemctl --no-pager --full status auto-tune.timer 2>/dev/null | head -15 || true

echo
echo "=========================================="
echo "公网 IPv4"
echo "=========================================="

curl -4 -s https://api.ipify.org || true

echo

echo
echo "=========================================="
echo "Huawei DDNS 最近日志"
echo "=========================================="

tail -30 /var/log/huawei-ddns.log 2>/dev/null || true

echo
echo "=========================================="
echo "安装完成"
echo "=========================================="
